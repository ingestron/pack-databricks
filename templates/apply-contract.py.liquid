GOVERNANCE = json.loads(r"""{{ governance }}""")
{% endif %}# Values that differ between environments: the job passes each as a parameter
# ingestron.<name>=<value>, and ${ingestron.<name>} above stands for it.
VALUES = dict(argument.split("=", 1) for argument in sys.argv[1:] if "=" in argument)


def with_values(text):
    """The text with each ${ingestron.<name>} replaced by its value."""
    for name, value in VALUES.items():
        text = text.replace("${" + name + "}", value)
    return text


def passes(operator, expected, measured):
    """True when the measured count meets the rule's comparison."""
    if operator == "mustBe":
        return measured == expected
    if operator == "mustNotBe":
        return measured != expected
    if operator == "mustBeGreaterThan":
        return measured > expected
    if operator == "mustBeGreaterOrEqualTo":
        return measured >= expected
    if operator == "mustBeLessThan":
        return measured < expected
    if operator == "mustBeLessOrEqualTo":
        return measured <= expected
    low, high = expected
    inside = low <= measured <= high
    return inside if operator == "mustBeBetween" else not inside


def measure(spark, check):
    """The rule's count, in rows or as a percentage of all rows."""
    row = spark.sql(with_values(check["query"])).first()
    counted, total = row["counted"] or 0, row["total"] or 0
    if check["unit"] == "percent":
        return 0 if total == 0 else counted * 100 / total
    return counted


