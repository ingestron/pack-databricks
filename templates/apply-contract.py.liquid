        message = f'{with_values(check["table"])}: {check["name"]} measured {measured}, expected {check["operator"]} {check["value"]}'
        if check["action"] == "fail":
            failures.append(message)
        else:
            print(f"Warning: {message}")
    if failures:
        raise RuntimeError("Table checks failed:\n" + "\n".join(failures))


